{
  "info": {
    "_postman_id": "sathvika-pern-erp-case-study",
    "name": "Sathvika Mini ERP - PERN Case Study API",
    "description": "Comprehensive Postman collection for PERN Full-Stack Technical Case Study.\nWorkflow: Customer Enquiry -> Quotation -> Sales Order -> Inventory Reservation -> Dispatch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "salesToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Roles",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "    pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sathvika.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login as Sales User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "    pm.collectionVariables.set('salesToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sales@sathvika.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Get Current User Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Step 1: Customer Enquiry",
      "item": [
        {
          "name": "List All Enquiries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "enquiries"
              ]
            }
          }
        },
        {
          "name": "Create New Multi-Item Customer Enquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": {\n    \"companyName\": \"Precision Engineering Solutions Pvt Ltd\",\n    \"contactPerson\": \"Anand Rao\",\n    \"mobile\": \"+91 98450 11223\",\n    \"email\": \"procurement@precisioneng.in\",\n    \"city\": \"Bengaluru\"\n  },\n  \"requiredDate\": \"2026-10-15T00:00:00.000Z\",\n  \"notes\": \"Urgent requirement for hydraulic plant overhaul\",\n  \"items\": [\n    {\n      \"productId\": \"REPLACE_WITH_PROD_ID_1\",\n      \"quantity\": 20\n    },\n    {\n      \"productId\": \"REPLACE_WITH_PROD_ID_2\",\n      \"quantity\": 10\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "enquiries"
              ]
            }
          }
        },
        {
          "name": "Update Enquiry Status (NEW -> QUOTED -> WON / LOST)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"QUOTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enquiries/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "enquiries",
                ":id",
                "status"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Step 2: Commercial Quotation",
      "item": [
        {
          "name": "List All Quotations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotations"
              ]
            }
          }
        },
        {
          "name": "Generate Quotation Against Enquiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enquiryId\": \"REPLACE_WITH_ENQUIRY_ID\",\n  \"validUntil\": \"2026-11-01T00:00:00.000Z\",\n  \"discountPercent\": 10,\n  \"gstPercent\": 18,\n  \"items\": [\n    {\n      \"productId\": \"REPLACE_WITH_PROD_ID_1\",\n      \"quantity\": 10,\n      \"unitPrice\": 450\n    },\n    {\n      \"productId\": \"REPLACE_WITH_PROD_ID_2\",\n      \"quantity\": 2,\n      \"unitPrice\": 1850\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotations"
              ]
            }
          }
        },
        {
          "name": "Update Quotation Status (DRAFT -> SENT -> ACCEPTED / REJECTED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations/:id/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotations",
                ":id",
                "status"
              ]
            }
          }
        },
        {
          "name": "Convert ACCEPTED Quotation to Sales Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotations/:id/convert",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotations",
                ":id",
                "convert"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Steps 3, 4 & 5: Sales Orders, Stock Reservation & Dispatch",
      "item": [
        {
          "name": "List All Sales Orders with Stock Feasibility",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales-orders"
              ]
            }
          }
        },
        {
          "name": "Step 4: Confirm Sales Order & Atomically Reserve Stock (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/:id/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales-orders",
                ":id",
                "confirm"
              ]
            }
          }
        },
        {
          "name": "Step 5: Process Dispatch (Deducts Physical & Reserved Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"MH-12-AB-4567\",\n  \"driverName\": \"Rajesh Patil\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales-orders/:id/dispatch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales-orders",
                ":id",
                "dispatch"
              ]
            }
          }
        },
        {
          "name": "Cancel Sales Order (Releases Reserved Stock Back to Available)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-orders/:id/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sales-orders",
                ":id",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Warehouse Inventory Master",
      "item": [
        {
          "name": "Get Real-Time Warehouse Inventory (Physical, Reserved, Available)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{salesToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory"
              ]
            }
          }
        },
        {
          "name": "Adjust Physical or Damaged Stock (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"physicalQuantity\": 250,\n  \"damagedQuantity\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/:productId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory",
                ":productId"
              ]
            }
          }
        }
      ]
    }
  ]
}